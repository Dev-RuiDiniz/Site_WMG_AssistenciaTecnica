# Ambiente local padrão do Vite
# Copie este arquivo para .env.local quando precisar sobrescrever valores localmente.

# URL pública usada para metadados e links do site.
VITE_SITE_URL=http://localhost:5173

# Nome público exibido em áreas institucionais.
VITE_COMPANY_NAME=WMG Assistência Técnica

# E-mail público de contato exibido no site.
VITE_CONTACT_EMAIL=suporte@wmgassistenciatecnica.com.br

# Telefone público de contato exibido no site.
VITE_CONTACT_PHONE=+55 12 99158-8460

# Cidade/UF exibida em áreas institucionais.
VITE_COMPANY_LOCATION=Taubaté - SP

# Analytics e eventos.
# Mantenha false em desenvolvimento local quando não quiser disparar tags reais.
VITE_ANALYTICS_ENABLED=false

# Google Analytics 4 Measurement ID público, exemplo: G-XXXXXXXXXX.
VITE_GA_MEASUREMENT_ID=

# Google Tag Manager Container ID público, exemplo: GTM-XXXXXXX.
VITE_GTM_ID=
